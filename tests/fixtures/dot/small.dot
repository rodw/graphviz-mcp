digraph small {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#eef3ff", fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  subgraph cluster_a { label="Group A"; style=dashed; a1; a2; a1 -> a2; }
  subgraph cluster_b { label="Group B"; b1; b2; b1 -> b2 [label="inner"]; }
  start [shape=circle]; end [shape=doublecircle];
  start -> a1; a2 -> b1 [label="to B"]; b2 -> end; a1 -> end [style=dotted, color=gray40];
  rec [shape=record, label="{<l>left|<m>mid|<r>right}"];
  b1 -> rec:m;
}
